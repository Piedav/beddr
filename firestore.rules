rules_version = '2';

// NOTE: This is the first `firestore.rules` file tracked in this repo — the
// live rules currently deployed for this project are not visible here.
// `profiledb` and `competitiondb` below are reconstructed from what the app
// code actually relies on today (see app/competition.tsx reading other
// players' profiledb docs, app/join.tsx merging into arbitrary competition
// codes). Diff this against the Firebase console's Rules tab before
// deploying — it may need to be merged with, not replace, what's live.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // --- Existing collections ---

    match /profiledb/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);
    }

    match /competitiondb/{competitionId} {
      allow read: if isSignedIn();
      // Permissive to match current behavior: join.tsx/competition.tsx let
      // any signed-in user create a competition doc or merge into
      // `players.{their own uid}`. Tightening this to "can only write your
      // own players entry" would need small client-side changes too.
      allow create, update: if isSignedIn();
    }

    // --- Friends (new) ---

    match /friendCodes/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /friendRequests/{requestId} {
      allow read: if isSignedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);

      allow create: if isSignedIn() &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.status == 'pending';

      // Recipient accepts/declines; sender may cancel their own pending
      // request, or edit it (e.g. fromName after a rename) while it stays
      // pending.
      allow update: if isSignedIn() &&
        ((resource.data.toUid == request.auth.uid &&
          resource.data.status == 'pending' &&
          request.resource.data.status in ['accepted', 'declined']) ||
         (resource.data.fromUid == request.auth.uid &&
          resource.data.status == 'pending' &&
          request.resource.data.status in ['pending', 'cancelled']));

      // Either participant can delete (covers account deletion cleanup).
      allow delete: if isSignedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    match /friendships/{pairId} {
      // `resource` is null when the doc doesn't exist yet (the common case:
      // sendFriendRequest() does a getDoc() here just to check "are we
      // already friends?"). Without the `resource == null` branch, Firestore
      // errors out evaluating `resource.data` on a nonexistent doc and denies
      // the read entirely — nothing to protect there since no data exists.
      allow read: if isSignedIn() &&
        (resource == null || request.auth.uid in resource.data.uids);
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.uids;
      // No update — friendships are immutable. Either party can delete
      // (covers account deletion cleanup; also doubles as future "unfriend").
      allow delete: if isSignedIn() && request.auth.uid in resource.data.uids;
    }

    // --- Co-op lock-in (new) ---

    match /lockInvites/{inviteId} {
      allow read: if isSignedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.fromUid == request.auth.uid;
      // Recipient accepts/declines; sender could later cancel their own.
      allow update: if isSignedIn() &&
        (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
    }

    match /lockSessions/{sessionId} {
      allow read: if isSignedIn() &&
        (resource == null || request.auth.uid in resource.data.members);
      allow create: if isSignedIn() && request.resource.data.hostUid == request.auth.uid;
      // Permissive like competitiondb above: any signed-in user can update
      // membership (join/leave their own `members.{uid}` entry). Real
      // gatekeeping happens at the app layer — you only ever see an accept
      // action for an invite addressed to you. Firestore rules can't cleanly
      // express "only touch your own map sub-key" without more complexity
      // than this warrants right now; tighten later if it becomes a problem.
      allow update: if isSignedIn();
    }
  }
}
